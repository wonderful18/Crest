{
  "uid": "crest-task-cache",
  "title": "Crest 任务与缓存",
  "tags": [
    "crest",
    "tasks",
    "cache"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "服务",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "crest-prometheus"
        },
        "query": "label_values(up, job)",
        "current": {
          "selected": false,
          "text": "crest-service",
          "value": "crest-service"
        },
        "includeAll": false,
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "executor",
        "label": "线程池",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "crest-prometheus"
        },
        "query": "label_values(executor_active_threads{job=\"$job\"}, name)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "cache",
        "label": "缓存",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "crest-prometheus"
        },
        "query": "label_values(cache_gets_total{job=\"$job\"}, cache)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      }
    ]
  },
