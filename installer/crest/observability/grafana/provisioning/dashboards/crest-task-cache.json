      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "crest-prometheus"
          },
          "expr": "sum(executor_active_threads{job=\"$job\",name=~\"$executor\"})",
          "legendFormat": "",
          "refId": "S",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
