      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "crest-prometheus"
          },
          "expr": "sum(jvm_memory_used_bytes{job=\"$job\"}) by (area)",
          "legendFormat": "used {{area}}",
          "refId": "J",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "crest-prometheus"
