          "expr": "sum(jvm_memory_committed_bytes{job=\"$job\"}) by (area)",
          "legendFormat": "committed {{area}}",
          "refId": "M",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "crest-prometheus"
          },
          "expr": "sum(jvm_memory_max_bytes{job=\"$job\",area=\"heap\"})",
          "legendFormat": "heap max",
          "refId": "D",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "bytes",
          "decimals": 2
        },
        "overrides": []
