          "expr": "(count(count by (method, uri) (http_server_requests_seconds_count{job=\"$job\",uri=~\"$uri\",uri!=\"UNKNOWN\",uri!=\"/**\",uri!=\"/websocket/**\",uri!~\".*/actuator/.*\"}) and on(method, uri) crest_api_route_info{module=~\"$module\",uri=~\"$uri\"})) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series"
