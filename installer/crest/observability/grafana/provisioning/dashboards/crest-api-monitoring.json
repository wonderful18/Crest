            "uid": "crest-prometheus"
          },
          "expr": "100 * count(crest_api_route_info{module=~\"$module\",uri=~\"$uri\"}) / clamp_min(count(crest_api_route_info{module=~\"$module\",uri=~\"$uri\"}), 1)",
