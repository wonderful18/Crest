{
  "uid": "crest-api-monitoring",
  "title": "Crest API 监控",
  "tags": [
    "crest",
    "api"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 8,
  "refresh": "15s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "服务",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "crest-prometheus"
        },
        "query": "label_values(up, job)",
        "current": {
          "selected": false,
          "text": "crest-service",
          "value": "crest-service"
        },
        "includeAll": false,
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "module",
        "label": "业务模块",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "crest-prometheus"
        },
        "query": "label_values(crest_api_route_info, module)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "uri",
        "label": "接口",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "crest-prometheus"
        },
        "query": "label_values(crest_api_route_info{module=~\"$module\"}, uri)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "status",
        "label": "状态码",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "crest-prometheus"
        },
        "query": "label_values(http_server_requests_seconds_count{job=\"$job\"}, status)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "已登记业务接口",
      "datasource": {
        "type": "prometheus",
        "uid": "crest-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "crest-prometheus"
          },
          "expr": "count(crest_api_route_info{module=~\"$module\",uri=~\"$uri\"})",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
