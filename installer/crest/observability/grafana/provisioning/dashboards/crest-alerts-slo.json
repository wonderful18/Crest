          "expr": "(100 * sum(rate(http_server_requests_seconds_count{job=\"$job\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"$job\"}[5m])), 0.001)) or vector(0)",
