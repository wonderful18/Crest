{
  "uid": "crest-database-pool",
  "title": "Crest 数据库与连接池",
  "tags": [
    "crest",
    "database"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "服务",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "crest-prometheus"
        },
        "query": "label_values(up, job)",
        "current": {
          "selected": false,
          "text": "crest-service",
          "value": "crest-service"
        },
        "includeAll": false,
        "refresh": 1,
        "sort": 1
      },
      {
        "name": "pool",
        "label": "连接池",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "crest-prometheus"
        },
        "query": "label_values(hikaricp_connections_active{job=\"$job\"}, pool)",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [],
          "type": "dashboard"
        },
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "活跃连接",
      "datasource": {
        "type": "prometheus",
        "uid": "crest-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "crest-prometheus"
          },
          "expr": "sum(hikaricp_connections_active{job=\"$job\",pool=~\"$pool\"})",
          "legendFormat": "",
          "refId": "B",
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
